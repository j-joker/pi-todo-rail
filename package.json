{
  "name": "pi-todo-rail",
  "version": "0.1.0",
  "description": "A branch-aware Todo rail for Pi with automatic verified progress, keyboard control, and animated task handoff.",
  "type": "module",
  "license": "MIT",
  "author": "j-joker",
  "homepage": "https://github.com/j-joker/pi-todo-rail#readme",
  "bugs": {
    "url": "https://github.com/j-joker/pi-todo-rail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-joker/pi-todo-rail.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "todo",
    "task-management",
    "coding-agent",
    "tui"
  ],
  "files": [
    "context.ts",
    "index.ts",
    "panel.ts",
    "state.ts",
    "tool.ts",
    "widget.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-transform-types render.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
